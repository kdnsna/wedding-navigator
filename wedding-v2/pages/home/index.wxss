.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 72rpx;
}

.hero-kicker {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 20rpx;
  letter-spacing: 0.36em;
  color: var(--ink-faint);
  text-transform: uppercase;
}

.hero-kicker .line {
  width: 56rpx;
  height: 1rpx;
  background: var(--hairline);
}

.hero-seal {
  margin: 56rpx 0 40rpx;
}

.hero-title {
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 0.1em;
}

.hero-slogan {
  margin-top: 16rpx;
  font-size: 24rpx;
  letter-spacing: 0.16em;
  color: var(--ink-soft);
}

/* ---------- 创建入口 ---------- */

.cta-wrap {
  margin: 24rpx 48rpx 0;
}

/* ---------- 我的婚礼 ---------- */

.mine {
  margin: 64rpx 48rpx 0;
}

.mine-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  font-size: 20rpx;
  letter-spacing: 0.32em;
  color: var(--ink-faint);
}

.mine-header .line {
  width: 40rpx;
  height: 1rpx;
  background: var(--hairline);
}

.mine-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 34rpx 36rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.mine-card:active {
  opacity: 0.7;
  transform: scale(0.99);
}

.mine-names {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
}

.mine-date {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
}

.mine-arrow {
  font-size: 44rpx;
  color: var(--ink-faint);
}

.mine-empty {
  margin: 64rpx 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* ---------- 配置指引 ---------- */

.setup-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--ink-soft);
}

/* ---------- 页脚 ---------- */

.footer {
  margin-top: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.footer-rule {
  width: 56rpx;
  height: 1rpx;
  background: var(--hairline);
}

.footer-sub {
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: var(--ink-faint);
  text-align: center;
  padding: 0 48rpx;
}
