<view class="aurora">
  <view class="blob blob-1"></view>
  <view class="blob blob-2"></view>
  <view class="blob blob-3"></view>
  <view class="blob blob-4"></view>
</view>

<view class="status-bar-spacer" style="height: {{statusBarHeight}}px"></view>

<!-- 加载中 -->
<view class="state-card glass" wx:if="{{!loaded}}">
  <text class="state-text">正在打开请柬…</text>
</view>

<!-- 未选择 / 请柬不存在 -->
<view class="state-card glass" wx:elif="{{!wedding}}">
  <view class="seal state-seal">囍</view>
  <text class="state-title serif">还没有打开的请柬</text>
  <text class="state-text">从分享卡片进入，或去首页创建你们的婚礼</text>
  <view class="btn btn-primary state-btn" bindtap="goHome">去首页</view>
</view>

<block wx:else>
<view class="page-head">
  <view class="kicker">Wishes</view>
  <view class="page-title">祝福墙</view>
  <view class="page-desc">写下一句话，送给{{wedding.couple.groom}}和{{wedding.couple.bride}}</view>
</view>

<!-- 书写区 -->
<view class="card compose">
  <view class="card-title">写下祝福</view>

  <view class="field-label">怎么称呼你（可留空）</view>
  <input class="input" value="{{name}}" maxlength="12" placeholder="你的名字或昵称" placeholder-class="input-placeholder" bindinput="onNameInput" />

  <view class="field-label">祝福的话</view>
  <textarea class="textarea" value="{{text}}" maxlength="200" placeholder="百年好合，岁岁常相见…" placeholder-class="textarea-placeholder" bindinput="onTextInput" />

  <view class="btn btn-primary compose-btn {{submitting ? 'is-disabled' : ''}}" bindtap="submit">送上祝福</view>
</view>

<!-- 祝福列表 -->
<view class="bless-list" wx:if="{{list.length}}">
  <view class="bless-item glass" wx:for="{{list}}" wx:key="createdAt">
    <text class="bless-quote serif">“</text>
    <text class="bless-text">{{item.text}}</text>
    <view class="bless-meta">
      <text class="bless-name serif">{{item.name}}</text>
      <text class="bless-time">{{item.timeText}}</text>
    </view>
  </view>
</view>

<view class="bless-empty" wx:else>
  <text>还没有祝福，来做第一个送上心意的人</text>
</view>
</block>

<view class="safe-bottom"></view>
