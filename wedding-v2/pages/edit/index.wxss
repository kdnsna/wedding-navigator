/* ---------- 玻璃返回按钮（同 rsvp 页范式） ---------- */

/* 页头为返回按钮让位 */
.page-head {
  padding-top: 150rpx;
}

.back-btn {
  position: fixed;
  left: 32rpx;
  z-index: 99;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--glass-bg-strong);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: 50%;
  box-shadow: var(--glass-shadow), var(--glass-specular);
  font-size: 48rpx;
  line-height: 1;
  color: var(--ink);
  transition: opacity 0.15s ease;
}

.back-btn:active {
  opacity: 0.6;
}

/* ---------- picker 字段（外观对齐 .input） ---------- */

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--hairline);
  font-size: 28rpx;
  color: var(--ink);
}

.picker-field::after {
  content: '›';
  font-family: var(--serif);
  color: var(--ink-faint);
}

.picker-field.is-placeholder {
  color: var(--ink-faint);
}

/* ---------- 地图选择 / 添加环节 ghost 按钮 ---------- */

.map-btn,
.add-row-btn {
  margin-top: 28rpx;
  height: 80rpx;
  font-size: 26rpx;
}

/* ---------- 流程行编辑器 ---------- */

.timeline-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--hairline-soft);
}

.timeline-time {
  width: 116rpx;
  flex-shrink: 0;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--hairline);
  font-size: 26rpx;
  text-align: center;
  color: var(--ink);
}

.timeline-time.is-placeholder {
  color: var(--ink-faint);
}

.timeline-input {
  flex: 1;
  min-width: 0;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.row-del {
  width: 48rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 40rpx;
  line-height: 1;
  color: var(--ink-faint);
  transition: opacity 0.15s ease;
}

.row-del:active {
  opacity: 0.5;
}

/* ---------- 底部固定保存栏（玻璃写法同 custom-tab-bar） ---------- */

.save-bar {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 99;
  padding: 16rpx;
  box-sizing: border-box;
  background: rgba(252, 248, 241, 0.55);
  backdrop-filter: blur(60rpx) saturate(1.7);
  -webkit-backdrop-filter: blur(60rpx) saturate(1.7);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 64rpx;
  box-shadow: 0 16rpx 56rpx rgba(122, 84, 60, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.save-spacer {
  height: calc(220rpx + env(safe-area-inset-bottom));
}

.is-disabled {
  opacity: 0.4;
}
