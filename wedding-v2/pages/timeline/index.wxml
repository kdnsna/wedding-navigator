<view class="aurora">
  <view class="blob blob-1"></view>
  <view class="blob blob-2"></view>
  <view class="blob blob-3"></view>
  <view class="blob blob-4"></view>
</view>

<view class="status-bar-spacer" style="height: {{statusBarHeight}}px"></view>

<!-- 加载中 -->
<view class="state-card glass" wx:if="{{!loaded}}">
  <text class="state-text">正在打开请柬…</text>
</view>

<!-- 未选择 / 请柬不存在 -->
<view class="state-card glass" wx:elif="{{!wedding}}">
  <view class="seal state-seal">囍</view>
  <text class="state-title serif">还没有打开的请柬</text>
  <text class="state-text">从分享卡片进入，或去首页创建你们的婚礼</text>
  <view class="btn btn-primary state-btn" bindtap="goHome">去首页</view>
</view>

<block wx:else>
<view class="page-head">
  <view class="kicker">Wedding Day</view>
  <view class="page-title">婚礼流程</view>
  <view class="page-desc">{{wedding.date.display}} · {{wedding.date.weekday}} · {{wedding.venue.name}}</view>
</view>

<view class="tl glass" wx:if="{{items.length}}">
  <view class="tl-item {{item.state}}" wx:for="{{items}}" wx:key="time">
    <view class="tl-time serif">{{item.time}}</view>

    <view class="tl-track">
      <view class="tl-dot"></view>
      <view class="tl-line" wx:if="{{!item.last}}"></view>
    </view>

    <view class="tl-body">
      <view class="tl-title-row">
        <text class="tl-title serif">{{item.title}}</text>
        <text class="tl-badge" wx:if="{{item.state === 'current'}}">进行中</text>
      </view>
      <text class="tl-note" wx:if="{{item.note}}">{{item.note}}</text>
    </view>
  </view>
</view>

<view class="tl-empty" wx:else>流程尚未发布</view>

<view class="tl-tip" wx:if="{{isToday}}">今日大婚 · 流程随时间自动更新</view>
</block>

<view class="safe-bottom"></view>
