/* ---------- 玻璃返回按钮（与 rsvp 同款） ---------- */

.back-btn {
  position: fixed;
  left: 32rpx;
  z-index: 99;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--glass-bg-strong);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: 50%;
  box-shadow: var(--glass-shadow), var(--glass-specular);
  font-size: 48rpx;
  line-height: 1;
  color: var(--ink);
  transition: opacity 0.15s ease;
}

.back-btn:active {
  opacity: 0.6;
}

/* 页头为返回按钮让位 */
.album-head {
  padding-top: 150rpx;
}

/* ---------- 状态卡（加载中 / 空态） ---------- */

.state-card {
  margin: 200rpx 48rpx 0;
  padding: 72rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-seal {
  margin-bottom: 40rpx;
}

.state-title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
}

.state-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--ink-soft);
  text-align: center;
}

.state-btn {
  margin-top: 48rpx;
  width: 100%;
}

/* 空相册卡：紧随页头，不需要大留白 */
.album-empty {
  margin-top: 48rpx;
}

/* ---------- 画册流 ---------- */

.feed {
  margin: 8rpx 48rpx 0;
}

.photo-item {
  margin-bottom: 72rpx;
  opacity: 0;
  transform: translateY(36rpx);
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.photo-item.vis {
  opacity: 1;
  transform: translateY(0);
}

/* 玻璃卡纸装裱 */
.photo-mat {
  padding: 18rpx;
  background: var(--glass-bg-strong);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: 12rpx;
  box-shadow: var(--glass-shadow), var(--glass-specular);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.photo-mat:active {
  opacity: 0.92;
  transform: scale(0.995);
}

.photo {
  display: block;
  width: 100%;
  border-radius: 6rpx;
}

/* 图注：衬线标题 + 序号 */
.photo-meta {
  margin-top: 20rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.photo-caption {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--ink);
}

.photo-index {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--ink-faint);
}

/* ---------- 页脚 ---------- */

.album-footer {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.footer-rule {
  width: 56rpx;
  height: 1rpx;
  background: var(--hairline);
}

.footer-text {
  font-size: 26rpx;
  letter-spacing: 0.12em;
  color: var(--ink-soft);
}

.footer-sub {
  font-size: 20rpx;
  letter-spacing: 0.24em;
  color: var(--ink-faint);
}
