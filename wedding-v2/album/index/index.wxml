<view class="aurora">
  <view class="blob blob-1"></view>
  <view class="blob blob-2"></view>
  <view class="blob blob-3"></view>
  <view class="blob blob-4"></view>
</view>

<!-- 玻璃返回按钮 -->
<view class="back-btn" style="top: calc({{statusBarHeight}}px + 16rpx)" bindtap="goBack">‹</view>

<view class="status-bar-spacer" style="height: {{statusBarHeight}}px"></view>

<!-- 加载中 -->
<view class="state-card glass" wx:if="{{!loaded}}">
  <text class="state-text">正在打开相册…</text>
</view>

<!-- 未选择 / 婚礼不存在 -->
<view class="state-card glass" wx:elif="{{!wedding}}">
  <view class="seal state-seal">囍</view>
  <text class="state-title serif">还没有打开的相册</text>
  <text class="state-text">从请柬的「婚纱影像」进入，或去首页看看</text>
  <view class="btn btn-primary state-btn" bindtap="goHome">去首页</view>
</view>

<block wx:else>
<view class="page-head album-head">
  <view class="kicker">Our Gallery</view>
  <view class="page-title">婚纱影像</view>
  <view class="page-desc">光影里的我们 · 轻点照片可放大细看</view>
</view>

<view class="feed" wx:if="{{photos.length}}">
  <view
    class="photo-item {{vis[index] ? 'vis' : ''}}"
    wx:for="{{photos}}"
    wx:key="fileID"
    data-i="{{index}}"
  >
    <view class="photo-mat" bindtap="preview" data-i="{{index}}">
      <image class="photo" src="{{item.fileID}}" mode="widthFix" lazy-load />
    </view>
    <view class="photo-meta">
      <text class="photo-caption serif">{{item.caption}}</text>
      <text class="photo-index">{{item.num}}</text>
    </view>
  </view>
</view>

<!-- 空相册 -->
<view class="state-card glass album-empty" wx:else>
  <text class="state-text">新人还没有上传照片</text>
</view>

<view class="album-footer">
  <view class="footer-rule"></view>
  <text class="footer-text serif">{{wedding.couple.groom}} · {{wedding.couple.bride}}</text>
  <text class="footer-sub">{{wedding.date.display}}</text>
</view>
</block>

<view class="safe-bottom-plain"></view>
