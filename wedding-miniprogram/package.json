{
  "name": "wedding-miniprogram",
  "version": "2.0.14",
  "description": "婚礼全流程导航小程序",
  "main": "main.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "check:release": "node scripts/check-release-readiness.js",
    "dev:app": "uni",
    "dev:custom": "uni -p",
    "dev:h5": "UNI_INPUT_DIR=. npm exec --yes --package=node@20.19.6 -- node node_modules/.bin/uni",
    "dev:h5:ssr": "UNI_INPUT_DIR=. npm exec --yes --package=node@20.19.6 -- node node_modules/.bin/uni --ssr",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:mp-baidu": "uni -p mp-baidu",
    "dev:mp-weixin": "UNI_INPUT_DIR=. npm exec --yes --package=node@20.19.6 -- node node_modules/.bin/uni -p mp-weixin",
    "dev:quickapp": "uni -p quickapp",
    "build:app": "uni build",
    "build:custom": "uni build -p",
    "build:h5": "UNI_INPUT_DIR=. npm exec --yes --package=node@20.19.6 -- node node_modules/.bin/uni build",
    "build:h5:ssr": "UNI_INPUT_DIR=. npm exec --yes --package=node@20.19.6 -- node node_modules/.bin/uni build --ssr",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:mp-baidu": "uni build -p mp-baidu",
    "build:mp-weixin": "UNI_INPUT_DIR=. npm exec --yes --package=node@20.19.6 -- node node_modules/.bin/uni build -p mp-weixin",
    "postbuild:mp-weixin": "node scripts/copy-cloudfunctions-to-dist.js dist/build/mp-weixin && node scripts/normalize-wechat-project-config.js dist/build/mp-weixin",
    "smoke:cloud-e2e": "node scripts/smoke-cloud-e2e.mjs",
    "build:quickapp": "uni build -p quickapp",
    "upload:mp-weixin": "node upload.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-4010520240507001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-4010520240507001",
    "@dcloudio/uni-h5": "3.0.0-alpha-4010520240507001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-4010520240507001",
    "@dcloudio/uni-mp-baidu": "3.0.0-alpha-4010520240507001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-4010520240507001",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "9.10.2"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.8",
    "@dcloudio/uni-automator": "3.0.0-alpha-4010520240507001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-4010520240507001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-4010520240507001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-4010520240507001",
    "sass": "1.72.0",
    "typescript": "5.4.3",
    "vite": "5.2.8"
  }
}
